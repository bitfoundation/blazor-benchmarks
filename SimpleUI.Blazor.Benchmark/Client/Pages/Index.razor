@page "/"

<div class="container">
    <Button Text="@($"Counter: {counter}")" OnClick="IncreaseCounter" />
    
    <DatePicker />

    <lable For="label-input">A Label for An Input</lable>
    <input type="text" name="label-input" id="label-input" />
</div>

<style>
    .container{
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 300px;
    }
</style>

@code {
    int counter;

    void IncreaseCounter()
    {
        counter++;
    }
}