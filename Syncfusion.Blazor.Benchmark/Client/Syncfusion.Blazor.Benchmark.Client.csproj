<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantTimezone>true</InvariantTimezone>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.2" PrivateAssets="all" />
		<PackageReference Include="Syncfusion.Blazor.Buttons" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Blazor.Calendars" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Blazor.ProgressBar" Version="28.2.7" />
		<PackageReference Include="Syncfusion.Blazor.Themes" Version="28.2.7" />
	</ItemGroup>

</Project>
